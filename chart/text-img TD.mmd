flowchart TD
    %% 样式定义（使用 rx 替代 rounded）
    classDef startend fill:#e8f4f8,stroke:#2c7fb8,stroke-width:2px,rx:10;
    classDef core fill:#fdf2f8,stroke:#9f7aea,stroke-width:3px,rx:10;
    classDef branch fill:#f5f5f5,stroke:#48bb78,stroke-width:2px,rx:8;
    classDef judge fill:#fff3cd,stroke:#f6ad55,stroke-width:2px,rx:8;

    %% 1. 起始与输入
    A["📥 输入原始数据"]:::startend -->|文本数据：内容/坐标/分类/置信度<br/>元件数据：类别/检测框/分割轮廓/置信度| B["🔍 数据预处理"]
    
    %% 2. 预处理阶段
    B --> B1["过滤低置信度样本<br/>文本≥0.5 | 元件≥0.7"]
    B1 --> B2["数据分类拆分<br/>①芯片元件(chip) ②普通元件(电阻/电容/接地等)<br/>①芯片类文本 ②普通类文本"]
    
    %% 3. 核心分支1：芯片一对多匹配（核心逻辑）
    B2 --> C["🎯 芯片元件匹配分支"]:::branch
    C --> C1["提取芯片分割轮廓坐标（segmentation）"]
    C1 --> C2["遍历所有芯片类文本<br/>计算文本中心原始坐标"]
    C2 --> C3{"射线法判断<br/>文本中心是否在芯片轮廓内？"}:::judge
    C3 -- ✅ 是 --> C4["归属该芯片（一对多匹配）"]:::core
    C3 -- ❌ 否 --> C5["暂存为「未匹配芯片文本」"]
    C4 --> C6["兜底匹配：未匹配芯片文本<br/>归属到距离最近的芯片"]
    C5 --> C6
    
    %% 4. 核心分支2：普通元件一对一匹配
    B2 --> D["🎯 普通元件匹配分支"]:::branch
    D --> D1["筛选未匹配文本<br/>仅保留与普通元件类别匹配的文本"]
    D1 --> D2["多特征加权得分计算<br/>7维特征：距离/方位/IOU/尺寸比/置信度等"]
    D2 --> D3["构建文本-元件得分矩阵"]
    D3 --> D4["匈牙利算法全局最优匹配<br/>实现一对一精准配对"]:::core
    D4 --> D5["过滤低得分匹配（阈值≥0.6）"]
    
    %% 5. 结果整合与输出
    C6 --> E["📊 匹配结果整合"]
    D5 --> E
    E --> E1["合并双分支匹配结果"]
    E1 --> E2["补充未匹配元件的空结果<br/>确保所有元件都有匹配记录"]
    E2 --> F["📤 输出结构化结果"]:::startend
    F -->|"component: 元件信息,\nmatched_texts: 文本列表,\nmatch_type: 匹配方式"| G["🖥️ 可选：结果可视化<br/>标注芯片轮廓+文本位置+匹配关系"]
    G --> H["🔚 流程结束"]:::startend

    %% 移除了 linkStyle（索引不稳定，且非必需）